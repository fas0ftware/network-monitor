# Settings read by the app. Never commit .env.
# Load with: set -a; . ./.env; set +a   (Windows PowerShell: set each variable with $env:NAME="value")
# Subnet to scan (the app refuses ranges larger than /20)
NETMON_IP_RANGE=192.168.1.0/24
# SQLite file
NETMON_DB=devices.db
# Push notifications (optional)
# ntfy: install the ntfy app, subscribe to a hard-to-guess topic, put its URL here
# NETMON_NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic
# Discord / Slack / Mattermost incoming webhook
# NETMON_WEBHOOK_URL=
# Dashboard: listen address (default 127.0.0.1 = this computer only) and port
# NETMON_HOST=127.0.0.1
# NETMON_PORT=5000
# Required (16+ chars) if NETMON_HOST is not a loopback address
# NETMON_TOKEN=
